{
  "name": "ai-resume-job-matcher",
  "version": "1.0.0",
  "description": "AI Resume & Job Matcher migrated to Node.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx server.ts",
    "build:client": "esbuild src/client/index.tsx --bundle --outfile=public/bundle.js --minify --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "npm run build:client && tsc",
    "start": "tsx server.ts",
    "test": "tsx tests/test_system.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "csv-parse": "^7.0.2",
    "express": "^4.21.2",
    "lucide-react": "^1.48.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
